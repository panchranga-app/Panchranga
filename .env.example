# Supabase Credentials (Free Tier)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# LLM Summarizer & Translator Cascade (Free Tiers)
GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id-here
CLOUDFLARE_API_TOKEN=your-cloudflare-workers-ai-token-here
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Aggregator API Keys
CURRENTS_API_KEY=your-currents-api-key-here

# Site URL & Security
NEXT_PUBLIC_SITE_URL=https://panchranga.app
NEWSLETTER_SECRET_KEY=your-64-character-secret-key

# Cloudflare Web Analytics
# Find your beacon token in: Cloudflare dashboard > Web Analytics > Add a site > JS snippet
NEXT_PUBLIC_CF_BEACON_TOKEN=

# Newsletter Email Providers Configuration
# Provider selection order: comma-separated list (e.g. "resend,brevo,gmail")
EMAIL_PROVIDER_ORDER=resend,brevo,gmail

# 1. Dedicated Gmail Account over SMTP (Fallback)
GMAIL_USER=your-dedicated-newsletter@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
GMAIL_DAILY_LIMIT=100

# 2. Optional: Brevo (Transactional Email API)
# Active only if BREVO_ENABLED=true
BREVO_ENABLED=false
BREVO_API_KEY=xkeysib-your-api-key-here
BREVO_SENDER_EMAIL=your-sender@gmail.com
BREVO_SENDER_NAME=Panchranga
BREVO_DAILY_LIMIT=290

# 3. Primary Custom Domain: Resend (API)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=Panchranga <news@panchranga.app>
RESEND_DAILY_LIMIT=95

# Testing & Dry Run Flags
# Set DRY_RUN=true to calculate and print planned provider splits without sending any emails
DRY_RUN=false
# Set TEST_RECIPIENTS to a comma-separated list to send ONLY to those addresses (skips DB subscriber table & send log)
# TEST_RECIPIENTS=you@example.com,test@example.com
