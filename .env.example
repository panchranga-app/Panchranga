# Supabase Credentials (Free Tier)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# LLM Summarizer (choose Groq or Gemini)
GROQ_API_KEY=your-groq-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# Aggregator API Keys
CURRENTS_API_KEY=your-currents-api-key-here

# Site URL & Security
NEXT_PUBLIC_SITE_URL=https://panchranga.vercel.app
NEWSLETTER_SECRET_KEY=your-64-character-secret-key

# Newsletter Email Providers Configuration
# Provider selection order: comma-separated list (e.g. "gmail,brevo,resend")
EMAIL_PROVIDER_ORDER=gmail,brevo,resend

# 1. Primary: Dedicated Gmail Account over SMTP
GMAIL_USER=your-dedicated-newsletter@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
GMAIL_DAILY_LIMIT=100

# 2. Optional: Brevo (Transactional Email API)
# Active only if BREVO_ENABLED=true
BREVO_ENABLED=false
BREVO_API_KEY=xkeysib-your-api-key-here
BREVO_SENDER_EMAIL=your-sender@gmail.com
BREVO_SENDER_NAME=Panchranga
BREVO_DAILY_LIMIT=290

# 3. Optional: Resend (API)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_DAILY_LIMIT=95

# Testing & Dry Run Flags
# Set DRY_RUN=true to calculate and print planned provider splits without sending any emails
DRY_RUN=false
# Set TEST_RECIPIENTS to a comma-separated list to send ONLY to those addresses (skips DB subscriber table & send log)
# TEST_RECIPIENTS=you@example.com,test@example.com
